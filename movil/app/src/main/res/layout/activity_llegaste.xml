                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/m1e_llegaste" style="@style/TextoTitleL" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/m1e_hora" style="@style/TextoBodyM" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="248dp">
