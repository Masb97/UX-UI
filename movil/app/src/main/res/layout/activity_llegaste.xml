                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="8dp" android:background="@drawable/fondo_etiqueta_mapa" android:padding="4dp" android:text="@string/m1e_mapa_hora" android:textSize="12sp" android:textColor="@color/on_surface" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/fondo_tarjeta">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/m1e_guardar_pregunta" style="@style/TextoTitleL" />
                <TextView android:id="@+id/detalle_guardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/TextoBodyM" />
