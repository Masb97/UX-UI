                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_no_gracias" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/m1e_no_gracias" android:textAllCaps="false" android:textSize="16sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="999dp" />
                </LinearLayout>
