    <com.google.android.material.button.MaterialButton android:id="@+id/btn_usar" android:layout_width="0dp" android:layout_height="48dp" android:layout_margin="16dp" android:enabled="false" android:text="@string/m2_usar" android:textAllCaps="false" android:textSize="16sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="999dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
