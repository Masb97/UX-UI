                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="8dp" android:background="@drawable/fondo_etiqueta_mapa" android:padding="4dp" android:text="@string/m2b_distancia" android:textSize="12sp" android:textColor="@color/on_surface" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/fondo_punto_fijado" android:paddingStart="16dp" android:paddingEnd="16dp" android:drawableStart="@drawable/ic_punto_confirmado" android:drawablePadding="12dp" android:gravity="center_vertical" android:text="@string/m2b_fijado" android:textSize="16sp" android:textColor="@color/on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/m2b_nombre" style="@style/TextoTitleL" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/m2b_ayuda" style="@style/TextoBodyM" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/etiquetas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="0dp">
                <com.google.android.material.chip.Chip android:id="@+id/etiqueta_casa" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/casa" android:textSize="14sp" android:checkable="true" app:chipBackgroundColor="@color/chip_punto_fondo" app:chipStrokeColor="@color/chip_punto_borde" app:chipStrokeWidth="1dp" app:chipCornerRadius="999dp" app:checkedIconVisible="true" app:checkedIconTint="@color/primary" />
                <com.google.android.material.chip.Chip android:id="@+id/etiqueta_trabajo" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/trabajo" android:textSize="14sp" android:checkable="true" app:chipBackgroundColor="@color/chip_punto_fondo" app:chipStrokeColor="@color/chip_punto_borde" app:chipStrokeWidth="1dp" app:chipCornerRadius="999dp" app:checkedIconVisible="true" app:checkedIconTint="@color/primary" />
                <com.google.android.material.chip.Chip android:id="@+id/etiqueta_universidad" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m2b_universidad" android:textSize="14sp" android:checkable="true" app:chipBackgroundColor="@color/chip_punto_fondo" app:chipStrokeColor="@color/chip_punto_borde" app:chipStrokeWidth="1dp" app:chipCornerRadius="999dp" app:checkedIconVisible="true" app:checkedIconTint="@color/primary" />
                <com.google.android.material.chip.Chip android:id="@+id/etiqueta_otro" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m2b_otro" android:textSize="14sp" android:checkable="true" app:chipBackgroundColor="@color/chip_punto_fondo" app:chipStrokeColor="@color/chip_punto_borde" app:chipStrokeWidth="1dp" app:chipCornerRadius="999dp" app:checkedIconVisible="true" app:checkedIconTint="@color/primary" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_guardar_usar" android:layout_width="0dp" android:layout_height="48dp" android:layout_margin="16dp" android:text="@string/m2b_guardar" android:textAllCaps="false" android:textSize="16sp" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="@color/primary" android:textColor="@color/on_primary" app:cornerRadius="999dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
